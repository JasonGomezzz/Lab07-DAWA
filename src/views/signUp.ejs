<%- include('partials/head', { styles: ['pages/auth'] }) %>
<%- include('partials/header') %>

<main id="contenido" class="shell auth">
  <section class="auth__aside">
    <h1 class="display">Solicita tu <em>pase.</em></h1>
    <p class="lede">
      Completa tus datos una sola vez. Tu cuenta nace con el rol de usuario;
      los permisos de administración no se piden desde este formulario.
    </p>
    <%- include('partials/passport-cover', { coverTitle: 'Solicitud de pase' }) %>
  </section>

  <section class="auth__panel" aria-labelledby="titulo-form">
    <div class="panel-head">
      <h2 id="titulo-form">Crear cuenta</h2>
      <span class="meta mono">POST /api/auth/signUp</span>
    </div>

    <div data-notice hidden></div>

    <form id="form-signup" class="form-stack" novalidate>
      <div class="row">
        <div class="input-field col s12 m6">
          <label for="name">Nombre</label>
          <input id="name" name="name" autocomplete="given-name" required maxlength="60" placeholder="Luis">
          <span class="supporting-text"></span>
        </div>
        <div class="input-field col s12 m6">
          <label for="lastName">Apellido</label>
          <input id="lastName" name="lastName" autocomplete="family-name" required maxlength="60" placeholder="Huamán">
          <span class="supporting-text"></span>
        </div>
      </div>

      <div class="row">
        <div class="input-field col s12 m6">
          <label for="phoneNumber">Teléfono</label>
          <input id="phoneNumber" name="phoneNumber" type="tel" inputmode="tel" autocomplete="tel" required maxlength="19" placeholder="987 654 321">
          <span class="supporting-text">Dígitos, espacios o guiones.</span>
        </div>
        <div class="input-field col s12 m6">
          <label for="birthdate">Fecha de nacimiento <small class="age-hint" data-age-hint aria-live="polite"></small></label>
          <input id="birthdate" name="birthdate" type="date" required>
          <span class="supporting-text">Con ella calculamos tu edad.</span>
        </div>
      </div>

      <div class="input-field">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" inputmode="email" autocomplete="email" required placeholder="nombre@correo.com">
        <span class="supporting-text">Será tu usuario para ingresar.</span>
      </div>

      <div class="input-field">
        <label for="password">Contraseña</label>
        <div class="input-affix">
          <input id="password" name="password" type="password" autocomplete="new-password" required placeholder="Crea una contraseña segura" aria-describedby="reglas-password">
          <button type="button" class="affix-btn" data-toggle-password="password" aria-label="Mostrar contraseña" aria-pressed="false">
            <svg class="icon"><use href="#i-eye"/></svg>
          </button>
        </div>
        <span class="supporting-text"></span>
        <ul id="reglas-password" class="password-rules" data-password-rules aria-label="Requisitos de la contraseña"></ul>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-ink">
          <span data-label>Crear cuenta</span>
          <svg class="icon icon-arrow"><use href="#i-arrow"/></svg>
        </button>
      </div>
    </form>

    <p class="auth__switch">¿Ya tienes una cuenta? <a class="text-link" href="/signIn">Ingresa con tu pase</a></p>
  </section>
</main>

<%- include('partials/footer', { script: 'signUp' }) %>
