# Puerto del servidor Express
PORT=3000

# Cadena de conexión a MongoDB (auth_db es el nombre de la base de datos)
MONGODB_URI=mongodb://localhost:27017/auth_db

# Clave para firmar y verificar los JWT. Genera una propia: openssl rand -hex 32
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-de-64-caracteres
# Tiempo de vida del token (formato de jsonwebtoken: 15m, 1h, 1d)
JWT_EXPIRES_IN=1h

# Rondas de sal para bcrypt
BCRYPT_SALT_ROUNDS=10
